# =============================================================================
# 1. CORE APPLICATION & ENVIRONMENT
# =============================================================================
NODE_ENV=development
PORT=9999
APP_URL=http://localhost:7777
# [CLOUD DEPLOYMENT] Domain công khai do Render tự cấp phát (tự động ưu tiên thay vì localhost khi deploy lên Render)
RENDER_EXTERNAL_URL=


# =============================================================================
# 3. JWT AUTHENTICATION & TOKENS (RS256 Asymmetric & HS256)
# =============================================================================
# Thuật toán ký JWT (RS256 cho Microservices, hoặc HS256)
JWT_ALGORITHM=RS256
JWT_KEY_ID=template-be-auth-key-1
# RSA Private Key (PEM format, base64 hoặc đường dẫn file). Bỏ trống trong dev sẽ tự động sinh cặp khóa 2048-bit an toàn.
JWT_PRIVATE_KEY=""
# RSA Public Key (PEM format, base64 hoặc đường dẫn file).
JWT_PUBLIC_KEY=""
# URL endpoint JWKS của Auth Service (dùng cho các satellite microservices tải public keys)
AUTH_JWKS_URL=""
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_characters_long
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_characters_long
# [SECURITY] Secret riêng cho 2FA temp token - phân tách khỏi access token secret để tránh token confusion attack.
# Nếu bỏ trống, hệ thống tự tạo fallback = JWT_ACCESS_SECRET + "_2FA_TEMP".
# Khuyến nghị: đặt giá trị tường minh trong production (min 32 chars).
JWT_TEMP_SECRET=your_jwt_temp_secret_min_32_characters_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# =============================================================================
# 4. SECURITY, REVERSE PROXY & CORS
# =============================================================================
# TRUST_PROXY: true, false, loopback, linklocal, uniquelocal, specific IP/CIDR, or number of hops
TRUST_PROXY=false
# ALLOWED_ORIGINS: Comma-separated list of allowed CORS domains (Wildcard * disallowed in production)
ALLOWED_ORIGINS=http://localhost:7777,http://localhost:3000,http://localhost:5173

# =============================================================================
# 4a. API GATEWAY (Phase 4 — Traefik Reverse Proxy)
# =============================================================================
# [GATEWAY_INTERNAL_SECRET] Secret nội bộ dùng để xác thực request đến từ API Gateway (Traefik).
# Traefik phải inject header `x-gateway-secret` với cùng giá trị này.
# Để trống trong dev/monolith mode → kiểm tra bị tắt (backward-compatible).
# BẮT BUỘC cấu hình trong production khi deploy đằng sau Traefik.
# Khuyến nghị: chuỗi ngẫu nhiên tối thiểu 32 ký tự.
GATEWAY_INTERNAL_SECRET=

# =============================================================================
# 5. ENCRYPTION & DATA PROTECTION (AES-256-GCM)
# =============================================================================
# Master Encryption Key (Must be at least 32 characters long in production)
ENCRYPTION_KEY=your_32_character_master_secret_key!
APP_SECRET=your_32_character_master_secret_key!

# =============================================================================
# 6. REDIS & DISTRIBUTED PUBSUB / BULLMQ
# =============================================================================
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6381
REDIS_PASSWORD=
# Optional Redis connection string / DSN (if provided, overrides REDIS_HOST/PORT/PASSWORD)
REDIS_URL=

# =============================================================================
# 7. RATE LIMITING (In-Memory Sliding Log)
# =============================================================================
# General API Rate Limiting: 1000 requests per 15 minutes (900000 ms)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
# Auth Sensitive Endpoints (Login, 2FA, Password Reset): 30 requests per 15 minutes
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=30

# =============================================================================
# 8. CLOUDFLARE R2 / S3 OBJECT STORAGE
# =============================================================================
R2_ACCOUNT_ID=your_r2_account_id
R2_BUCKET_NAME=your_r2_bucket_name
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_PUBLIC_BASE_URL=https://your-public-r2-url.r2.dev
R2_PRESIGNED_URL_EXPIRES_IN_SECONDS=300
R2_AVATAR_MAX_FILE_SIZE_MB=5

# =============================================================================
# 9. NOTIFICATION MICROSERVICE & WORKER (Phase 5: Satellite Service)
# =============================================================================
NOTIFICATION_PORT=8889
# Đặt thành true khi triển khai Notification Service dưới dạng container/tiến trình độc lập
NOTIFICATION_SERVICE_STANDALONE=false
NOTIFICATION_SERVICE_URL=http://localhost:8889
NOTIFICATION_WORKER_ENABLED=true
NOTIFICATION_WORKER_INTERVAL_MS=60000

# =============================================================================
# 9b. MEDIA & STORAGE MICROSERVICE (Phase 6: Satellite Service)
# =============================================================================
MEDIA_PORT=8890
# Đặt thành true khi triển khai Media Service dưới dạng container/tiến trình độc lập
MEDIA_SERVICE_STANDALONE=false
MEDIA_SERVICE_URL=http://localhost:8890

# =============================================================================
# 10. WEBHOOK DELIVERY & RETRIES
# =============================================================================
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_TIMEOUT_MS=10000

# =============================================================================
# 11. GOOGLE OAUTH2 SOCIAL LOGIN
# =============================================================================
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
# [SECURITY] Danh sách Redirect URI hợp lệ cho Google OAuth2 flow (exact match, phân cách bằng dấu phẩy).
# BẮT BUỘC khai báo trong production. Bỏ trống → server từ chối khởi động ở production.
# Phải khớp chính xác với URI đã đăng ký trong Google Cloud Console.
# VD: https://myapp.com/auth/callback,https://admin.myapp.com/auth/callback
GOOGLE_OAUTH_ALLOWED_REDIRECT_URIS=http://localhost:3000/auth/callback

# =============================================================================
# 12. MAIL / MULTI-TIER DISPATCH PIPELINE (Resend -> Webhook Relay -> SMTP IPv4)
# =============================================================================
# Tầng 1 (Ưu tiên): Resend HTTPS REST API (Port 443 không bao giờ bị chặn trên Cloud)
# Đăng ký tại https://resend.com để lấy API key
RESEND_API_KEY=
# Tầng 2: Mail Webhook Relay (Port 443 e.g. Google Apps Script mail relay)
MAIL_WEBHOOK_URL=
# Tầng 3: Gửi qua SMTP trực tiếp qua IPv4 (Gmail, Amazon SES, SendGrid, Mailgun)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_app_specific_password
MAIL_FROM="App Template <noreply@gmail.com>"

# =============================================================================
# 13. CLOUDFLARE TURNSTILE (CAPTCHA / ANTI-BOT)
# =============================================================================
# Bật/tắt xác thực Turnstile (true/false). Mặc định false (tự động bypass trong dev/test nếu không bật).
TURNSTILE_ENABLED=false
# Secret Key từ Cloudflare Dashboard (Bắt buộc trong production khi TURNSTILE_ENABLED=true).
# Key kiểm thử chính thức của Cloudflare:
# - Luôn pass: 1x0000000000000000000000000000000AA
# - Luôn fail: 2x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# =============================================================================
# 14. RFC 9116 SECURITY.TXT (VULNERABILITY DISCLOSURE POLICY)
# =============================================================================
# Email liên hệ tiếp nhận báo cáo lỗ hổng bảo mật (xuất hiện tại /.well-known/security.txt)
SECURITY_CONTACT_EMAIL=security@example.com
# URL chính sách bảo mật công khai (tùy chọn, để trống sẽ trỏ về Swagger Docs /api/docs)
SECURITY_POLICY_URL=
# URL bảng vinh danh nhà nghiên cứu bảo mật (tùy chọn)
SECURITY_ACKNOWLEDGMENTS_URL=

# =============================================================================
# 15. PPE MICROSERVICES INFRASTRUCTURE & DATABASE-PER-SERVICE (Bước 1)
# =============================================================================
# Quản lý bởi docker-compose.infra.yml
# Khởi động: docker compose -f docker-compose.infra.yml up -d

# --- 15a. PostgreSQL Infrastructure Container (Port 5433 tránh xung đột local 5432) ---
PPE_POSTGRES_PORT=5433
PPE_POSTGRES_USER=postgres
PPE_POSTGRES_PASSWORD=postgres_master_dev

# --- 15b. Database-per-Service Connection Strings (6 Isolated Logical DBs) ---
IDENTITY_DATABASE_URL="postgresql://ppe_identity_user:ppe_identity_dev_pass@localhost:5433/ppe_identity_db?schema=public"
SITE_DATABASE_URL="postgresql://ppe_site_user:ppe_site_dev_pass@localhost:5433/ppe_site_db?schema=public"
SITE_PORT=8891
CAMERA_DATABASE_URL="postgresql://ppe_camera_user:ppe_camera_dev_pass@localhost:5433/ppe_camera_db?schema=public"
CAMERA_PORT=8892
INCIDENT_DATABASE_URL="postgresql://ppe_incident_user:ppe_incident_dev_pass@localhost:5433/ppe_incident_db?schema=public"
INCIDENT_PORT=8893
NOTIFICATION_DATABASE_URL="postgresql://ppe_notification_user:ppe_notification_dev_pass@localhost:5433/ppe_notification_db?schema=public"
REPORTING_DATABASE_URL="postgresql://ppe_reporting_user:ppe_reporting_dev_pass@localhost:5433/ppe_reporting_db?schema=public"
REPORTING_PORT=8894

# --- 15c. Apache Kafka Event Bus (KRaft Mode - Zero Zookeeper) ---
PPE_KAFKA_PORT=9092
PPE_KAFKA_BROKERS=localhost:9092
PPE_KAFKA_UI_PORT=8088
KAFKA_TOPIC_VIOLATION_DETECTED=ppe.violation.detected

# --- 15d. MinIO Object Storage (Evidence Snapshots & Video Clips) ---
PPE_MINIO_API_PORT=9000
PPE_MINIO_CONSOLE_PORT=9001
PPE_MINIO_ROOT_USER=minio_admin
PPE_MINIO_ROOT_PASSWORD=minio_admin_secret
PPE_MINIO_ENDPOINT=http://localhost:9000
PPE_MINIO_BUCKET_EVIDENCES=ppe-evidences
PPE_MINIO_FORCE_PATH_STYLE=true